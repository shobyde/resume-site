      "q": "what about the second one",
      "context": { "items": ["Readback", "Groundglass", "Hobnob"], "subject": "Readback" },
      "expect": { "reference": "Groundglass" }
    },
    {
      "q": "tell me about the third project",
      "context": { "items": ["Readback", "Groundglass", "Hobnob"], "subject": "Groundglass" },
      "expect": { "reference": "Hobnob" }
    },
    {
      "q": "and the first one",
      "context": { "items": ["Groundglass", "boaz"], "subject": "Groundglass" },
      "expect": { "reference": "Groundglass" }
    },
    {
      "q": "what is the last one written in",
      "context": { "items": ["Readback", "Groundglass", "Hobnob"], "subject": "Hobnob" },
      "expect": { "reference": "Hobnob", "attribute": "stack" }
    },
    {
      "q": "number two, what stack does it use",
      "context": { "items": ["Hobnob", "Readback"], "subject": "Readback" },
      "expect": { "reference": "Readback" }
    },
    {
      "q": "the second card, where does it link",

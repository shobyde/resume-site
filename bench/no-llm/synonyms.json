{
  "class": "synonyms",
  "note": "Rung 5. Visitors do not use the app's vocabulary: they type utilise, toolset, js, postgres, essays, get in touch. Baseline is the naive exact-token scan (baseline: naive), the library side is analyzeQuestion() with whatever vocabulary it bundles. Tasks marked \"guard\" assert that the expansion does NOT fire: a two-letter alias must not appear inside a longer word.",
  "baseline": "naive",
  "subjects": [
    "Hobnob",
    "Readback",
    "Groundglass",
    "Boaz",
    "Python 3.10+",
    "TypeScript",
    "SQLite",
    "PostgreSQL",
    "JavaScript",
    "Rust",
    "Docker",
    "Go"
  ],
  "tasks": [
    { "q": "which projects utilise python", "expect": { "entities": ["Python 3.10+"], "attribute": "stack" } },
    { "q": "what does readback utilise", "expect": { "entities": ["Readback"], "attribute": "stack" } },
    { "q": "which projects leverage typescript", "expect": { "entities": ["TypeScript"], "attribute": "stack" } },
    { "q": "what is the toolset behind hobnob", "expect": { "entities": ["Hobnob"], "attribute": "stack" } },
    { "q": "what toolchain does groundglass run", "expect": { "entities": ["Groundglass"], "attribute": "stack" } },
    { "q": "which project runs on postgres", "expect": { "entities": ["PostgreSQL"], "attribute": "stack" } },
    { "q": "does anything use js", "expect": { "entities": ["JavaScript"], "attribute": "stack" } },
    { "q": "which projects are shipped in typescript", "expect": { "entities": ["TypeScript"], "attribute": "stack" } },
    { "q": "which projects used typescript", "expect": { "entities": ["TypeScript"], "attribute": "stack" } },
    { "q": "what is built on python", "expect": { "entities": ["Python 3.10+"], "attribute": "stack" } },
    { "q": "which projects are powered by sqlite", "expect": { "entities": ["SQLite"], "attribute": "stack" } },
    { "q": "what languages did he use in hobnob", "expect": { "entities": ["Hobnob"], "attribute": "stack" } },
    { "q": "what has he written in rust", "expect": { "entities": ["Rust"], "attribute": "stack" } },
    { "q": "what does he write essays about", "expect": { "attribute": "writing" } },
    { "q": "how do i get in touch", "expect": { "attribute": "contact" } },
    { "q": "what is the best way to reach out", "expect": { "attribute": "contact" } },
    { "q": "what is his bio", "expect": { "attribute": "identity" } },
    { "q": "what is his background", "expect": { "attribute": "identity" } },
    { "q": "is the site built with go", "expect": { "entities": ["Go"], "attribute": "stack" } },
    { "q": "which projects use docker and sqlite", "expect": { "entities": ["Docker", "SQLite"], "attribute": "stack", "combine": "all" } },
    { "q": "which projects use python or rust", "expect": { "entities": ["Python 3.10+", "Rust"], "attribute": "stack", "combine": "any" } },
    { "q": "which projects use charts", "expect": { "entities": [] }, "guard": "chart tokenises to chart, not to the ts alias" },
    { "q": "does the site use json", "expect": { "entities": [] }, "guard": "json is not the js alias" },
    { "q": "which projects use javascript", "expect": { "entities": ["JavaScript"], "attribute": "stack" }, "guard": "the canonical name still works" },
    { "q": "which projects use postgresql", "expect": { "entities": ["PostgreSQL"], "attribute": "stack" }, "guard": "the canonical name still works" }
  ]
}
